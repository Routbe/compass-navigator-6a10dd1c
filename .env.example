# Active driver: brevo (temporary) or infomaniak (Swiss SMTP)
MAIL_PROVIDER=
# Brevo v3 key (xkeysib-...); turn open/click tracking OFF in Brevo transactional settings
BREVO_API_KEY=
# Transactional mail — Infomaniak SMTP (Swiss). 465 = SSL, 587 = STARTTLS
SMTP_HOST=
SMTP_PORT=
SMTP_USER_AUTH=
SMTP_PASS_AUTH=
SMTP_USER_SYSTEM=
SMTP_PASS_SYSTEM=
# Optional secondary HTTPS API, used only on SMTP timeout/network errors (Postmark-compatible)
FALLBACK_MAIL_API_KEY=
# FALLBACK_MAIL_API_URL=https://api.postmarkapp.com/email
# Where contact forms and delivery alerts land
CONTACT_ADMIN_EMAIL=
# Ghost Mode (anonymous Q&A writing-style masking) — a sovereign, European
# OpenAI-compatible endpoint (e.g. Infomaniak AI Tools). The app calls
# <SOVEREIGN_AI_BASE_URL>/chat/completions. Without these, a local neutralizer is used.
SOVEREIGN_AI_BASE_URL=
SOVEREIGN_AI_API_KEY=
INFOMANIAK_AI_PRODUCT_ID=
SOVEREIGN_AI_MODEL=
